// Floating cloud HUD: a frameless, transparent, always-on-top window showing only
// the translation. The cloud itself is painted in Rust (src/cloud.rs) as three
// layers that drift at their own pace: wisps behind, the body, and a fringe of
// small puffs. Rust also clips the window to the cloud's shape so clicks next to
// it reach the windows behind.

// Candy fonts, both SIL OFL: Fredoka (semi-bold, very round) for English
// results, ZCOOL KuaiLe (站酷快乐体, playful) for Chinese. Missing characters
// fall back to system fonts.
import "fonts/ZCOOLKuaiLe-Regular.ttf";
import "fonts/Fredoka-SemiBold.ttf";
import { SettingsWindow } from "settings.slint";

export { SettingsWindow }

// A painted cloud image that can stand in for the minimized puff, so the
// cloud can grow out of it and shrink into it: `own` 1 draws the image at its
// painted size, 0 scales it to the puff's size with its text area's centre on
// the puff's.
component MorphImage inherits Image {
    in property <float> own: 1;
    in property <length> puff-width;
    in property <length> puff-height;
    // How far the text area's centre sits below the image's centre.
    in property <length> body-drop;
    property <length> w: self.source.width * 1px;
    property <length> h: self.source.height * 1px;
    property <float> k: root.own >= 1 || root.w == 0 ? 1
        : root.puff-width / root.w + (1 - root.puff-width / root.w) * root.own;
    // Where the text area's centre goes: from the puff's to the image's own.
    property <length> cx: root.puff-width / 2 + (root.w - root.puff-width) / 2 * root.own;
    property <length> cy: root.puff-height / 2 + root.body-drop + (root.h - root.puff-height) / 2 * root.own;
    width: root.w * root.k;
    height: root.h * root.k;
    x: root.cx - root.w / 2 * root.k;
    y: root.cy - (root.h / 2 + root.body-drop) * root.k;
}

// One layer of the painted cloud. When Rust hands over a repainted layer, it
// fades in over the previous one instead of popping. Both keep their painted
// size (one image pixel per logical pixel), so a stale layer is never stretched
// while the window changes size; only minimizing and opening scale them (see
// MorphImage).
component CloudLayer inherits Rectangle {
    in property <image> current;
    in property <image> previous;
    // 0 = just repainted, 1 = the new layer is fully in.
    in property <float> fade;
    // Applied to each image, not to this element: opacity on a container makes
    // the renderer draw it off-screen first, every frame.
    in property <float> strength: 1;
    in property <float> current-own: 1;
    in property <float> previous-own: 1;
    in property <length> puff-width;
    in property <length> puff-height;
    in property <length> body-drop;
    // Opening or minimizing: the new layer turns solid early, so the growing
    // cloud never looks like a grey ghost.
    in property <bool> morphing;
    MorphImage {
        source: root.previous;
        own: root.previous-own;
        puff-width: root.puff-width;
        puff-height: root.puff-height;
        body-drop: root.body-drop;
        visible: root.fade < 1;
        opacity: root.strength * (1 - Math.pow(root.fade, root.morphing ? 3 : 2));
    }
    MorphImage {
        source: root.current;
        own: root.current-own;
        puff-width: root.puff-width;
        puff-height: root.puff-height;
        body-drop: root.body-drop;
        opacity: root.strength * (root.morphing ? min(1, 3 * root.fade) : root.fade);
    }
}

component IconButton inherits Rectangle {
    callback clicked;
    out property <bool> hovered: ta.has-hover;
    width: 24px;
    height: 24px;
    border-radius: 12px;
    background: ta.pressed ? #d9e4f2c8 : ta.has-hover ? #e8eff8d0 : transparent;
    animate background { duration: 160ms; }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component Hud inherits Window {
    in property <string> result-text;
    in property <string> dict-text;
    in property <string> error-text;
    // A quiet remark under the result, e.g. "API failed, used Google".
    in property <string> note-text;
    in property <bool> busy;
    in property <bool> paused;
    in property <bool> copied;
    // The result is English: show it in the round Latin font.
    in property <bool> latin;
    // The cloud resizes to its content: Rust picks the width from the text length
    // and the height limit from the screen; past that the result scrolls.
    // The widest the text area may get; longer text wraps (Rust picks it from
    // the text's length and the screen).
    in property <length> max-body-width: 380px;
    in property <length> max-result-height: 600px;
    // The painted cloud layers, and the ones they replace (see CloudLayer).
    in property <image> body-image;
    in property <image> fringe-image;
    in property <image> wisp-image;
    in property <image> old-body-image;
    in property <image> old-fringe-image;
    in property <image> old-wisp-image;
    // Minimized to a small puff; a click or a new selection opens it again
    // (`open()`). The minimize button and Rust minimize it with `minimize()`.
    in-out property <bool> mini;

    // Where the text area sits; the cloud is painted around it.
    out property <length> side: 52px;
    out property <length> top-margin: 70px;
    out property <length> bottom-margin: 52px;
    // The text area just fits the text: as wide as its widest line (in steps of
    // 8px, so streaming text doesn't repaint the cloud for every character), at
    // least wide enough for the buttons.
    out property <length> body-width: root.mini ? 40px
        : clamp(ceil((root.natural-width + 2 * root.pad) / 8px) * 8px, 112px, root.max-body-width);
    out property <length> body-height: root.mini ? 22px : max(30px, body.preferred-height);

    callback drag-started();
    callback dragging();
    callback drag-finished();
    callback copy-result();
    callback toggle-pause();
    callback quit();
    callback open-settings();

    // Result fonts: round Fredoka for English, ZCOOL KuaiLe for Chinese.
    property <string> result-font: root.latin ? "Fredoka" : "ZCOOL KuaiLe";
    property <int> result-weight: root.latin ? 600 : 400;
    property <length> result-size: root.result-text != "" ? (root.latin ? 19px : 20px) : 16px;
    property <length> result-spacing: root.latin ? 0.2px : 0.5px;
    property <string> shown-text: root.result-text != "" ? root.result-text
        : root.paused ? "已暂停" : "选中文字，即刻翻译";
    // Padding between the text and the cloud's edge.
    property <length> pad: 12px;
    // Candy colours: strawberry, orange, lime, blueberry, grape.
    property <brush> candy: @linear-gradient(90deg, #f24b8f 0%, #f7892b 26%, #27b06e 50%, #3a86f0 74%, #9157f2 100%);

    // Seconds since start, advanced by Rust about 30 times a second. The drift
    // moves a fraction of a pixel per frame, so this looks as smooth as redrawing
    // at every screen refresh, for a fraction of the cost.
    in property <float> t;
    // Rust calls this right after handing over repainted layers, and clears
    // `fading` once they are in: only then is the cloud redrawn every refresh.
    public function cloud-repainted() {
        root.repainted-at = animation-tick();
        let now-mini = root.body-image.width * 1px == root.puff-width;
        root.morph = now-mini == root.painted-mini ? 0 : now-mini ? -1 : 1;
        root.painted-mini = now-mini;
        if now-mini {
            root.collapsing = false;
        }
    }
    in property <bool> fading;
    property <duration> repainted-at;
    property <float> fade: root.fading ? clamp((animation-tick() - root.repainted-at) / 320ms, 0, 1) : 1;

    // Minimizing, the cloud first shrinks to the puff's size, then the puff is
    // painted and fades in over it. Opening, the window grows at once, and once
    // the full cloud is painted it grows out of the puff.
    public function minimize() {
        if !root.mini && !root.collapsing {
            root.collapsing = true;
            root.collapse-at = animation-tick();
        }
    }
    public function open() {
        root.collapsing = false;
        root.mini = false;
    }
    property <length> puff-width: 40px + 2 * root.side;
    property <length> puff-height: root.top-margin + 22px + root.bottom-margin;
    property <length> body-drop: (root.top-margin - root.bottom-margin) / 2;
    property <bool> collapsing;
    property <duration> collapse-at;
    property <float> shrink: root.collapsing ? clamp((animation-tick() - root.collapse-at) / 300ms, 0, 1) : 0;
    collapse-timer := Timer {
        interval: 300ms;
        running: root.collapsing && !root.mini;
        triggered => {
            root.mini = true;
        }
    }
    // Whether the layers on show are the puff, and how the last repaint changed
    // that: 1 = opened, -1 = minimized.
    property <bool> painted-mini;
    property <int> morph;
    property <float> grow: root.morph == 1 ? root.fade * root.fade * (3 - 2 * root.fade) : 1;
    property <float> current-own: root.collapsing ? 1 - root.shrink * root.shrink * (3 - 2 * root.shrink) : root.grow;
    property <float> previous-own: root.morph == -1 ? 0 : 1;
    // Rising when the pointer rests on the cloud, slowly, like air carrying it.
    // The pointer is on the cloud, or on one of its buttons.
    out property <bool> pointer-in: ta.has-hover || ta.pressed || min-btn.hovered || copy-btn.hovered
        || pause-btn.hovered || close-btn.hovered;
    property <float> lift: root.pointer-in ? 1 : 0;
    animate lift { duration: 1100ms; easing: ease-in-out; }
    // Positive = higher up: a 5 s bob plus the lift (Rust allows for 12px of motion).
    property <length> float: 3px * Math.sin(root.t * 72deg) + 6px * root.lift;
    // The buttons stay hidden until the pointer comes onto the cloud.
    property <float> tools: root.pointer-in ? 1 : 0;
    animate tools { duration: 260ms; easing: ease-out; }

    title: "小白云";
    icon: @image-url("../assets/logo-128.png");
    no-frame: true;
    always-on-top: true;
    background: transparent;
    default-font-family: "ZCOOL KuaiLe";
    width: body-width + 2 * side;

    // Invisible copies that measure the text's natural (unwrapped) width.
    measure-result := Text {
        visible: false;
        text: root.shown-text;
        font-family: root.result-font;
        font-weight: root.result-weight;
        font-size: root.result-size;
        letter-spacing: root.result-spacing;
    }
    measure-dict := Text {
        visible: false;
        text: root.dict-text;
        font-family: root.result-font;
        font-weight: root.result-weight;
        font-size: 14px;
    }
    // Plus a little for the white outline around the letters.
    property <length> natural-width: max(measure-result.preferred-width, measure-dict.preferred-width) + 4px;
    height: top-margin + body-height + bottom-margin;

    // Wisps trail behind, swaying farther and fading in and out.
    CloudLayer {
        x: 7px * Math.sin(root.t * 26deg);
        y: -root.float * 0.6 + 2px * Math.sin(root.t * 31deg);
        current: root.wisp-image;
        previous: root.old-wisp-image;
        fade: root.fade;
        current-own: root.current-own;
        previous-own: root.previous-own;
        puff-width: root.puff-width;
        puff-height: root.puff-height;
        body-drop: root.body-drop;
        morphing: root.morph != 0;
        strength: 0.6 + 0.4 * Math.sin(root.t * 34deg + 40deg);
    }

    CloudLayer {
        y: -root.float;
        current: root.body-image;
        previous: root.old-body-image;
        fade: root.fade;
        current-own: root.current-own;
        previous-own: root.previous-own;
        puff-width: root.puff-width;
        puff-height: root.puff-height;
        body-drop: root.body-drop;
        morphing: root.morph != 0;
    }

    // The fringe churns slightly against the body, so the edges look alive.
    CloudLayer {
        x: 3px * Math.sin(root.t * 41deg + 20deg);
        y: -root.float + 2px * Math.sin(root.t * 53deg);
        current: root.fringe-image;
        previous: root.old-fringe-image;
        fade: root.fade;
        current-own: root.current-own;
        previous-own: root.previous-own;
        puff-width: root.puff-width;
        puff-height: root.puff-height;
        body-drop: root.body-drop;
        morphing: root.morph != 0;
        strength: 0.8 + 0.2 * Math.sin(root.t * 47deg);
    }

    // Drag the cloud anywhere (Rust moves the window with the cursor);
    // right-click for settings; click the small puff to open it again.
    property <bool> dragged;
    ta := TouchArea {
        mouse-cursor: root.mini ? MouseCursor.pointer : MouseCursor.move;
        moved => {
            if self.pressed {
                if abs(self.mouse-x - self.pressed-x) > 3px || abs(self.mouse-y - self.pressed-y) > 3px {
                    root.dragged = true;
                }
                root.dragging();
            }
        }
        pointer-event(e) => {
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                root.dragged = false;
                root.drag-started();
            }
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.up {
                root.drag-finished();
            }
            if e.button == PointerEventButton.right && e.kind == PointerEventKind.up {
                root.open-settings();
            }
        }
        clicked => {
            if root.mini && !root.dragged {
                root.open();
            }
        }
    }

    // The text layer floats as one piece; it is rendered once and reused while
    // only its position changes.
    Rectangle {
        visible: !root.mini;
        // Gone in the first half of shrinking; in the second half of growing.
        opacity: root.collapsing ? max(0, 1 - 2 * root.shrink)
            : root.painted-mini ? 0 : root.morph == 1 ? clamp((root.fade - 0.5) * 2, 0, 1) : 1;
        y: -root.float;
        width: root.width;
        height: root.height;
        cache-rendering-hint: true;
        // The status dot and buttons sit on the billows above the text, so they
        // take no room of their own; the buttons appear with the pointer.
        HorizontalLayout {
            x: side + root.pad - 4px;
            y: top-margin - 26px;
            width: body-width - 2 * root.pad + 8px;
            height: 24px;
            spacing: 2px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 7px;
                    height: 7px;
                    border-radius: 3.5px;
                    background: root.paused ? #b9c2cf : root.error-text != "" ? #e88080 : #8fc3f5;
                    opacity: root.busy ? 0.3 + 0.7 * abs(Math.sin(root.t * 400deg)) : 0.9;
                }
            }

            Rectangle { }

            min-btn := IconButton {
                opacity: root.tools;
                clicked => { root.minimize(); }
                Rectangle {
                    width: 10px;
                    height: 1.6px;
                    border-radius: 1px;
                    background: #8696ad;
                }
            }

            copy-btn := IconButton {
                opacity: root.tools;
                clicked => { root.copy-result(); }
                Path {
                    width: 11px;
                    height: 11px;
                    viewbox-width: 12;
                    viewbox-height: 12;
                    stroke: root.copied ? #4caf7a : #8696ad;
                    stroke-width: 1.2px;
                    commands: root.copied ? "M 2 6.5 L 5 9.5 L 10.5 2.5" : "M 4 4 L 11 4 L 11 11 L 4 11 Z M 1 8 L 1 1 L 8 1";
                }
            }

            pause-btn := IconButton {
                opacity: root.tools;
                clicked => { root.toggle-pause(); }
                if root.paused: Path {
                    width: 9px;
                    height: 11px;
                    viewbox-width: 10;
                    viewbox-height: 12;
                    fill: #8696ad;
                    commands: "M 1 0 L 10 6 L 1 12 Z";
                }
                if !root.paused: HorizontalLayout {
                    alignment: center;
                    spacing: 3px;
                    padding-top: 7px;
                    padding-bottom: 7px;
                    Rectangle { width: 2.5px; border-radius: 1px; background: #8696ad; }
                    Rectangle { width: 2.5px; border-radius: 1px; background: #8696ad; }
                }
            }

            close-btn := IconButton {
                opacity: root.tools;
                clicked => { root.quit(); }
                Path {
                    width: 9px;
                    height: 9px;
                    viewbox-width: 10;
                    viewbox-height: 10;
                    stroke: #8696ad;
                    stroke-width: 1.3px;
                    commands: "M 1 1 L 9 9 M 9 1 L 1 9";
                }
            }
        }

        body := VerticalLayout {
            x: side;
            y: top-margin;
            width: body-width;
            height: self.preferred-height;
            alignment: start;
            padding-left: root.pad;
            padding-right: root.pad;
            padding-bottom: 4px;
            spacing: 6px;


            // Only the translation. Very long ones scroll (mouse wheel).
            flick := Flickable {
                height: min(result.preferred-height, root.max-result-height);
                content-width: flick.width;
                content-height: result.preferred-height;
                // Candy letters: a soft lilac shadow underneath, then the text filled
                // with a rainbow-candy gradient and coated with a thin white outline.
                Text {
                    x: 0;
                    y: 1.5px;
                    width: result.width;
                    text: result.text;
                    font-size: result.font-size;
                    font-family: result.font-family;
                    font-weight: result.font-weight;
                    letter-spacing: result.letter-spacing;
                    wrap: word-wrap;
                    color: #d9c8ee;
                    opacity: result.opacity;
                }
                // As wide as the text itself, so even one word gets every candy colour.
                result := Text {
                    x: 0;
                    y: 0;
                    width: min(self.preferred-width, flick.width);
                    text: root.shown-text;
                    color: root.candy;
                    font-family: root.result-font;
                    font-weight: root.result-weight;
                    font-size: root.result-size;
                    letter-spacing: root.result-spacing;
                    stroke: #ffffff;
                    stroke-width: 1.5px;
                    stroke-style: outside;
                    wrap: word-wrap;
                    opacity: root.busy ? 0.5 : root.result-text != "" ? 1 : 0.6;
                    animate opacity { duration: 200ms; }
                }
            }

            // Dictionary entries, as wide as their text so the gradient spans them.
            if root.dict-text != "": HorizontalLayout {
                alignment: start;
                Text {
                    text: root.dict-text;
                    color: root.candy;
                    font-family: root.result-font;
                    font-weight: root.result-weight;
                    opacity: 0.75;
                    font-size: 14px;
                    wrap: word-wrap;
                }
            }

            if root.note-text != "": Text {
                text: root.note-text;
                font-family: "Microsoft YaHei UI";
                color: #9aa6b8;
                font-size: 11px;
                wrap: word-wrap;
                overflow: elide;
                height: min(self.preferred-height, 2 * 16px);
            }

            if root.error-text != "": Text {
                text: root.error-text;
                color: #c86464;
                font-size: 11px;
                wrap: word-wrap;
                overflow: elide;
                height: min(self.preferred-height, 2 * 16px);
            }
        }
    }
}
